# syntax=docker/dockerfile:1.7

FROM node:24-bookworm-slim AS builder

ENV COREPACK_HOME=/corepack \
    PNPM_HOME=/pnpm \
    PNPM_STORE_DIR=/pnpm/store \
    PATH=/corepack:${PATH}

RUN corepack enable \
    && corepack prepare pnpm@11.8.0 --activate

WORKDIR /workspace
COPY . .

RUN --mount=type=cache,id=ai-schedule-pnpm-store,target=/pnpm/store \
    pnpm config set fetch-timeout 600000 \
    && pnpm config set fetch-retries 5 \
    && pnpm install --filter @ai-schedule/client... --frozen-lockfile \
    && pnpm --filter @ai-schedule/client... build

FROM nginx:1.27-alpine

COPY deploy/test/nginx-container.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/apps/client/dist /usr/share/nginx/html

EXPOSE 8080
