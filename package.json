{
  "name": "ai-schedule",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "admin:password-set": "pnpm --filter @ai-schedule/server admin:password-set",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint playwright.config.ts tests/e2e --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "db:generate": "pnpm --filter @ai-schedule/db db:generate",
    "db:validate": "pnpm --filter @ai-schedule/db db:validate",
    "db:migrate:dev": "pnpm --filter @ai-schedule/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @ai-schedule/db db:migrate:deploy",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.61.1",
    "@testcontainers/postgresql": "12.0.4",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "turbo": "2.7.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vitest": "1.6.1"
  }
}
